# ============================================================
# IA Dictador / IADictador - variables de entorno de ejemplo
# Copiar este archivo como .env y completar valores privados.
#
# IMPORTANTE:
# - No subir .env real a Git.
# - El puerto se cambia SOLO aquí:
#     APP_PORT=8015
#   o en tu .env local:
#     APP_PORT=8014
# ============================================================

# API IA
OPENAI_API_KEY=

# Modelo interpretador futuro / compatibilidad
AI_PROVIDER=gpt
OPENAI_MODEL=gpt-5.4-mini

# Configuración app
APP_HOST=0.0.0.0
APP_BIND_IP=0.0.0.0
APP_PORT=8015

# IA Dictador - proveedores IA
IAD_AI_PROVIDER_DEFAULT=openai
IAD_AI_PROVIDER_TEMPLATE_IMPORT=openai
IAD_AI_MODEL_TEMPLATE_IMPORT=

# Reglas radiológicas editables
# Se recomienda /data porque está persistido en el volumen Docker.
IAD_RULES_FILE=/data/reglas_radiologicas.md

# Zona horaria
TZ=America/Santiago

# Seguridad / usuario inicial
IADICTADOR_SESSION_SECRET=cambia_este_secreto_largo
IADICTADOR_ADMIN_USER=admin
IADICTADOR_ADMIN_PASSWORD=admin1

# Base de datos y archivos
IADICTADOR_DB_URL=sqlite:////data/iadictador.sqlite3
IADICTADOR_UPLOAD_DIR=/data/uploads_iadictador

# Ambiente
IADICTADOR_ENV=production
IADICTADOR_ENABLE_DOCS=0

# Audio-first flow
IAD_AI_MODEL_AUDIO_FIRST=gpt-audio-1.5
IAD_AUDIO_FIRST_ALLOW_TRANSCRIPT_FALLBACK=0
IAD_AUDIO_FIRST_JSON_MODE=1
IAD_AUDIO_FIRST_REQUEST_AUDIO_OUTPUT=0
IAD_AI_MODEL_AUDIO_FIRST_NORMALIZER=gpt-4o-mini
IAD_AI_MODEL_AUDIO_FIRST_TEMPLATE_BRIDGE=gpt-4o-mini
EOF
